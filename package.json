{
  "name": "openvoyage",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "release": "release-it",
    "release:preview": "release-it --dry-run",
    "version:sync": "node scripts/sync-version.ts",
    "version:check": "node scripts/sync-version.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test scripts/*.test.ts"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "12.0.2",
    "@types/node": "22.20.5",
    "@types/semver": "7.8.0",
    "release-it": "21.1.1",
    "semver": "7.8.5",
    "typescript": "5.9.3"
  }
}
