{
  "name": "openvoyage-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "api:generate": "node scripts/generate-api.mjs",
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "check": "npm run lint && npm run build",
    "debug:seed-trip": "node scripts/seed-debug-trip.mjs",
    "debug:seed-live-location": "node scripts/seed-live-location-debug-trip.mjs",
    "debug:seed-live-post-route": "node scripts/seed-live-post-route-debug-trip.mjs",
    "debug:seed-closed-post-route": "node scripts/seed-closed-post-route-debug-trip.mjs",
    "start": "npm run dev",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "android:apk": "npm run cap:sync && node scripts/build-android.mjs"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@tailwindcss/vite": "4.1.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.1.17"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "9.27.0",
    "@playwright/test": "^1.62.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "9.27.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "fake-indexeddb": "^6.2.5",
    "globals": "16.0.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.30.1",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  }
}
