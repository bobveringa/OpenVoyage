# "local" downgrades the secret checks below to warnings so a scratch
# checkout starts without ceremony. Leave it at "production" (the default when
# unset) for anything reachable by someone other than you.
ENVIRONMENT=production

# Container image docker-compose.yml runs. Unset means the latest release.
# Pin a version for reproducible deployments, or use ":edge" to follow main.
# OPENVOYAGE_IMAGE=ghcr.io/bobveringa/openvoyage:1.2.3

# Domains that should be allowed by CORS, enter your frontend host location here
BACKEND_CORS_ORIGINS=https://example.com

# Signs every access, refresh, and media token. It must stay identical across
# restarts and across workers, or sessions drop at random. There is no default:
# the backend refuses to start until you set one.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Postgres
# These sh
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=openvoyage_db
POSTGRES_USER=openvoyage_user
POSTGRES_PASSWORD=openvoyage_password

MEDIA_DIRECTORY=./data/media

# Non-empty secret text used to derive encryption keys for secret runtime settings.
# Use a long, unique value and keep it stable after saving secret settings.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SETTINGS_ENCRYPTION_KEY=

# Optional credentials for API-backed Playwright tests against a local,
# already-configured instance. Keep real values in .env, which is gitignored.
# GitHub Actions provisions a disposable account instead and needs no secrets.
# E2E_LOGIN_EMAIL=e2e@example.com
# E2E_LOGIN_PASSWORD=choose-a-local-test-password
