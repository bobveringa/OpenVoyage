# Public URL of this installation. The Docker deployment serves the frontend
# and API from the same origin, so localhost:8000 is the development default.
FRONTEND_HOST=http://localhost:8000

# Comma-separated origins are only needed when the frontend is hosted
# separately from the API.
# BACKEND_CORS_ORIGINS=https://frontend.example.com

# Generate unique, persistent values before deploying.
SECRET_KEY=change-this-to-a-long-random-secret

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=travelblog_db
POSTGRES_USER=travelblog_user
POSTGRES_PASSWORD=travelblog_password

MEDIA_DIRECTORY=./data/media

# Non-empty secret text used to derive encryption keys for secret runtime settings.
# Use a long, unique value and keep it stable after saving secret settings.
APP_SETTINGS_ENCRYPTION_KEY=change-this-to-a-long-random-secret
